  "name": "Isekai Izakaya: Japanese Food from Another World",
  "name_english": "Isekai Izakaya: Japanese Food From Another World",
  "name_romanji": "Isekai Izakaya: Koto Aitheria no Izakaya Nobu",
  "original_title": "異世界居酒屋〜古都アイテーリアの居酒屋のぶ〜",
  "type": "series",
