        },
        {
          "id": 165683,
          "episode_number": 19,
          "name": "Sakura's Words",
          "description": "After a welcoming party for Sakura, the Asakuras and their friends repair the neglected Yoshino house. Sakura shoots down Aisia's hopes of magic lessons, and tries to explain the dangers of magic.",
          "release_date": "2005-11-05T00:00:00.000Z",
