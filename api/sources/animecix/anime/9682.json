        {
          "id": 165681,
          "episode_number": 17,
          "name": "Nemu ve Junichi",
          "description": "Aisia, Junichiye bakmak için Nemu ile rekabet etmeye çalışır (boşuna) ve onlara bir randevuda eşlik eder. Nemunun onu ne kadar umursadığını anlamaya başlar, ancak görünüşe göre anlayış veya şükran eksikliği yüzünden kafası karışır.",
          "release_date": "2005-10-22T00:00:00.000Z",
