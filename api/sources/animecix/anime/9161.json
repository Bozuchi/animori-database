        {
          "id": 161018,
          "episode_number": 4,
          "name": "Aktarılamayan Duygular",
          "description": "Geçmiş bir olaydan dolayı Katalina, Viraya borçlu hissediyor ve Viranın Lord Kumandan olarak katlandığı uzun yıllar boyunca baskı ve yalnızlıktan sonra ona destek sağlamak istiyor.",
          "release_date": "2019-10-26T00:00:00.000Z",
          "poster": "https://image.tmdb.org/t/p/original/aHPuE6xAX6QqTIDYl9oNS05YSU6.jpg",
          "videos": []
        },
        {
          "id": 161019,
          "episode_number": 5,
          "name": "Katalina ve Vira",
          "description": "İlk canavar Luminiera'nın gücünü serbest bırakan Vira, Gran ve diğerlerine saldırır. Vira'yı çılgına dönmüş halde gördüğünde, Katalina suçluluk duygusuyla yanıp tutuşur. Ve böylece Vira'nın duygularıyla yüzleşmeye, geçmişi telafi etmeye karar verir.",
          "release_date": "2019-11-02T00:00:00.000Z",
          "poster": "https://image.tmdb.org/t/p/original/4pdSV6ya2MhujHlUsGVPHKGwtTZ.jpg",
          "videos": []
        },
        {
          "id": 161020,
          "episode_number": 6,
          "name": "The Mist-Shrouded Island",
          "description": "After leaving Albion, the Grandcypher lands on an island shrouded in thick mist, notorious for being inescapable.",
          "release_date": "2019-11-16T00:00:00.000Z",
          "poster": "https://image.tmdb.org/t/p/original/aaW0bDzRDMIkNNrBoI7wEk5CFuN.jpg",
          "videos": []
        },
        {
          "id": 161021,
          "episode_number": 7,
          "name": "Ölümsüz İlkel Canavar",
          "description": "Lyria, Io ve Orchis, Celeste tarafından yutuldu. Geride kalan Gran ve diğerleri, köyde tanıştıkları hayalet kız Ferry ile birlikte onları kurtarmanın bir yolunu ararlar.",
          "release_date": "2019-11-23T00:00:00.000Z",
          "poster": "https://image.tmdb.org/t/p/original/AnzezIOyoKq1GSQbZUbLZw5rkTV.jpg",
          "videos": []
        },
        {
          "id": 161022,
          "episode_number": 8,
          "name": "Aile Anıları",
          "description": "Celeste birileri tarafından manipüle ediliyor. İlkeli köye saldırmaya ve yaşayan ölüleri yok etmeye zorlayan biri. Gran, Lyria, Io ve Orchisi kurtarmak için Celesteye atlama şansını yakalar.",
          "release_date": "2019-11-30T00:00:00.000Z",
          "poster": "https://image.tmdb.org/t/p/original/oowVxN7lRup79y7Edca00pN9PGN.jpg",
          "videos": []
        },
        {
          "id": 161023,
          "episode_number": 9,
          "name": "vaatler kasabası",
          "description": "Gran ve diğerleri, hasarlı Grandcypheri onarmak için gemi inşasının Mekkesi olarak bilinen Golonzo Adasına giderler.",
          "release_date": "2019-12-07T00:00:00.000Z",
          "poster": "https://image.tmdb.org/t/p/original/bVPu0H9MBTauKM7OVXYg7pCDCYb.jpg",
          "videos": []
        },
        {
          "id": 161024,
          "episode_number": 10,
          "name": "The Impossible Dream",
          "description": "Under the command of Pommern, the imperial army takes Gran and Lyria away. Meanwhile, Noa is held captive in a research lab as he suffers from the effects of dark essence.",
          "release_date": "2019-12-14T00:00:00.000Z",
