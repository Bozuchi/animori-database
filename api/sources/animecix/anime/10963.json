        {
          "id": 213353,
          "episode_number": 18,
          "name": "Yemin",
          "description": "Gelin Çeyizinin ayrılmasıyla Botan, Kadomori Saenome'nin kendisine getirdiği sınırlamalardan en iyi şekilde yararlanmanın bir yolunu arar.",
          "release_date": "2023-08-08T00:00:00.000Z",
