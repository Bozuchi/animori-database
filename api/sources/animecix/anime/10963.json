        {
          "id": 213351,
          "episode_number": 16,
          "name": "Gaddar",
          "description": "Hyoma, aradığı kişi olabilecek bir varlıkla karşı karşıya gelir, ancak çok geçmeden intikamından daha fazlasının tehlikede olduğunu öğrenir.",
          "release_date": "2023-07-25T00:00:00.000Z",
