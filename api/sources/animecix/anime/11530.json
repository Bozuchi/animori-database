    {
      "id": 5152,
      "season_number": 2,
      "name": null,
      "episode_count": 12,
      "episodes": [
        {
          "id": 213193,
          "episode_number": 1,
          "name": "Beni Kışkırtma!!",
          "description": "Chitose ve Ikkou, Toudou ailesine yardım etmekle görevlendirilir. Orada Ikkou, rakip tapınaktan Saienji'ye gelen özel bir keşiş olan Kazuki ile tanışır. Birlikte ruhları kovmaya çalışırlar ama kendileri için utanç verici durumlar yaratırlar. Daha sonra Ikkou ve Kazuki yalnız kaldıklarında onu \"doğru yola\" uyandırmaya çalışır.",
          "release_date": "2006-01-04T00:00:00.000Z",
          "poster": "https://image.tmdb.org/t/p/original/6xtK4LW2QZAFwQrUJHmjZnQagiE.jpg",
          "videos": []
        },
        {
          "id": 213194,
          "episode_number": 2,
          "name": "Bana hayran olmayın!!",
          "description": "Ikkou, Chitose, Sumi ve Yuuko artık ikinci sınıf öğrencileridir. Haruka ve Sakura üçüncü sınıf öğrencisi oldular ve Sakura yeni okul konseyi başkanı oldu. Hinata birinci sınıf öğrencisi oldu. Hinata, okula giriş töreni için diğer kızların her birinden birer büyü aldı. Törende Kazuki birinci sınıfları temsil ediyor ve bir konuşma yapıyor. Okul konseyi kurucusunun ruhu, konuşması sırasında tüm kız öğrencilerin eteklerini kaldıracak kadar kuvvetli rüzgarlar yaratıyor. Amaenaideyo çetesinin beş üyesi tarafından bastırılır. Ancak Kazuki onu serbest bırakır ve Ikkou'yu onu kovmak için uyanmaya zorlar.",
          "release_date": "2006-01-11T00:00:00.000Z",
          "poster": "https://image.tmdb.org/t/p/original/VSTLfpiRDbeLJnbeqsAi4S6Kyu.jpg",
          "videos": []
        },
        {
          "id": 213195,
          "episode_number": 3,
          "name": "Sakın Geri Gelme!!",
          "description": "Ikkou'nun hayalet arkadaşı Yagani, Kazuki'ye olan aşkını ilan eder çünkü onun tarafından şeytan çıkarılma hissinden hoşlanır. Ancak Kazuki onun ilerlemelerini reddeder. Okulun Ikkou için düzenlediği yıllık atletizm karnavalında Chitose'ye meydan okur. Kazuki'nin geri tepen sabotaj girişiminin ardından kendisini Ikkou ile birlikte beden eğitimi ekipman odasına kilitler.",
          "release_date": "2006-01-18T00:00:00.000Z",
          "poster": "https://image.tmdb.org/t/p/original/7SmcQvPR67OhODeDEZ6zb3h0VsK.jpg",
          "videos": []
        },
        {
          "id": 213196,
          "episode_number": 4,
          "name": "Yapma Haniwa!!",
          "description": "Hinata, Ikkou, Chitose, Sakura ve Kazuki birlikte haniwa kazısına gider. Kazuki, Ikkou'yu utanmadan baştan çıkarır ama hayranları tarafından sürekli engellenir. Öfkelenen Kazuki, yanlışlıkla kötü bir ruhu, dev bir haniwa'yı serbest bırakır. Hinata, ruhu yok etmek için küçük şeytanını bir canavara dönüştürmek zorunda kalır.",
          "release_date": "2006-01-25T00:00:00.000Z",
          "poster": "https://image.tmdb.org/t/p/original/lchPHkxPxsBbF3JGlmYnj0Ox1jR.jpg",
          "videos": []
        },
        {
          "id": 213197,
          "episode_number": 5,
          "name": "Düşmeyin!",
          "description": "Jotoku, Hinata ve Ikkou'yu Miyako'nun tapınağı Saichouji'ye göndererek Hinata'nın Altı Devlet'in karanlığın tezahürü olan bosatsu'sunun, iblisler diyarının üstesinden gelmesine olanak tanır. Chitose, Yuuko ve Sakura onları tapınağa kadar takip eder ve Miyako tarafından bulunur ve Saienji'ye geri gönderilir. Hinata, Miyako'nun kirli oyununu fark eden Ikkou'yu bastırmayı başarır.",
          "release_date": "2006-02-01T00:00:00.000Z",
          "poster": "https://image.tmdb.org/t/p/original/rRek8J2F7WpRbvXE46ZOTlZU3iJ.jpg",
          "videos": []
        },
        {
          "id": 213198,
          "episode_number": 6,
          "name": "Şaşkın olmayın!!",
          "description": "Saichouji'de bir haftalık eğitimin ardından Hinata ve Ikkou'nun, Hinata'nın eğitimini tamamlamak için cehenneme yakın birkaç yerden biri olan Danda Mağarası'na gitmeleri gerekir. Hinata, kız kardeşinin aşkı uğruna, küçük iblis hariç, iblis arkadaşlarıyla olan bağlarından vazgeçmeyi başarır. Hinata ve Ikkou için endişelenen ekibin geri kalanı, onlarla buluşmak için Saichouji'ye gider. Jotoku, kızların ev işlerini bıraktıklarını öğrendiğinde, Miyako'dan onlara şeffaf denizde deniz kabuğu dalışı gibi görevler vermesini ister. Miyako'nun Haruka'nın ablası olduğu ortaya çıkar.",
          "release_date": "2006-02-08T00:00:00.000Z",
          "poster": "https://image.tmdb.org/t/p/original/bxikZJmBRNhoG9tLywI5ksxS0WP.jpg",
          "videos": []
        },
        {
          "id": 213199,
          "episode_number": 7,
          "name": "Sıcaktan Korkmayın!!",
          "description": "Kediler ve köpekler Sumi'nin hayvanlar alemi olan bosatsu'ya ilgi duyuyor. Çetenin geri kalanı geceleri tapınakta devriye gezerken Sumi tapınakta kilitli kalır. Kazuki durumu öğrenir ve Ikkou'yu baştan çıkarmak için devriyeye katılır. Kazuki'nin baştan çıkarmasıyla uyanmaya direnen Ikkou'dan ilham alarak sutrayı okur ve köpekleri sakinleştirmeyi başarır.",
          "release_date": "2006-02-15T00:00:00.000Z",
          "poster": "https://image.tmdb.org/t/p/original/dtTlztvRKXBLouQNN7LlafcJsCC.jpg",
          "videos": []
        },
        {
          "id": 213200,
          "episode_number": 8,
          "name": "Yumurta Yapmayın!!",
          "description": "Ikkou'yu rehin olarak kullanan yerel çeteyle kavga eden Yuuko, hastanede Ikkou'yu ziyaret eder ve ona yiyecek verir. Ikkou yemek yedikten sonra bayılır. Küçük bir çocuğun annesinin yokluğu nedeniyle ameliyat olmayı reddettiğini görüyorlar. Küçük çocuğa empati duyan Yuuko, küçük çocuğa ameliyat olabilmesi için lezzetli bir yemek hazırlayacağına söz verir. İlk önce ağırlıklı olarak patatesten yapılan bir Japon yemeği olan niku jaga'yı deniyorlar. Birçok başarısız denemeden sonra güneşli tarafı yukarı doğru kızarmış yumurtalara geçiyorlar. Yuuko son denemesinde bunu başarır ve küçük çocuk son ürünü onaylar.",
          "release_date": "2006-02-22T00:00:00.000Z",
          "poster": "https://image.tmdb.org/t/p/original/jzgWxdyz6II7woTcNB9twy1KpV6.jpg",
          "videos": []
        },
        {
          "id": 213201,
          "episode_number": 9,
          "name": "Ağlama!!",
          "description": "Bir bebek Saienji'nin kapısına terk edilir. Ekip ve Kazuki, Jotoku'nun yokluğunda bebeği sakinleştirmeye çalışır. Kazuki, Ikkou'yu baştan çıkarmak için bebeği sakinleştirme bahanesini kullanır. Bebeği sakinleştirme konusunda doğal bir yeteneğe sahip olan Haruka'ya geçmişte ona bakan Miyako hatırlatılır.",
          "release_date": "2006-03-01T00:00:00.000Z",
          "poster": "https://image.tmdb.org/t/p/original/ctyXH3UqInpR0xAfvvTAKJtZtrz.jpg",
          "videos": []
        },
        {
          "id": 213202,
